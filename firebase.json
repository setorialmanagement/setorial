{
  "hosting": [
    {
      "target": "admin-target",
      "public": "admin/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [ { "source": "**", "destination": "/index.html" } ]
    },
    {
      "target": "web-target",
      "public": "web",
      "cleanUrls": true,
      "redirects": [
        {
          "source": "/",
          "destination": "/home",
          "type": 301
        }
      ],
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    }
  ]
}
